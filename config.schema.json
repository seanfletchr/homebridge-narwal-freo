              "description": "What each Home app clean mode does; only slots that differ from the defaults need to be listed."
            },
            "cleaningSensor": {
              "title": "Cleaning sensor",
              "type": "boolean",
              "default": false,
              "description": "Adds an occupancy sensor that shows Detected while the robot is on a cleaning job (from leaving the dock until the job ends, mop-wash visits to the dock included), so Home app automations can react to cleaning (the Home app can't trigger on the vacuum itself). Needs this child bridge paired in the Home app as well."
            },
            "consumables": {
              "title": "Consumables",
              "type": "boolean",
              "default": false,
              "description": "Remaining life of the filter, side brush, rolling brushes, mops and filter sponge, as in the Narwal app's maintenance page (updated hourly and after each clean). Apple's Home app doesn't display these; use a third-party HomeKit app such as Eve or Controller."
            },
            "replaceAtPercent": {
              "title": "Show \"replace\" at (% life left)",
              "type": "integer",
              "default": 10,
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "description": "The robots to show in the Home app, each with its own settings. Without this list, the first robot on the account is used."
      },
      "securityHold": {
        "title": "Keep security from arming Away while cleaning",
        "type": "boolean",
        "default": false,
        "description": "Keeps the security system from arming Away while a robot cleans: if it's armed Away when a robot starts, it's switched to Home, and Away comes back when the robot is done. Needs a security plugin that supports holds. See https://github.com/seanfletchr/homebridge-narwal-freo/blob/main/docs/security-hold.md"
      },
      "securityStoppedMinutes": {
        "title": "Back to Away when a robot stops moving for (minutes)",
        "type": "integer",
        "default": 10,
        "minimum": 0,
        "maximum": 240,
        "description": "A robot that stands still away from its base mid-job (stuck, lifted, paused…) can't set off motion sensors: after this many minutes it releases its hold, so the security system goes back to Away, and it switches to Home again as soon as it moves. Time at the base (mop washes, recharging) doesn't count. 0: keep Home until the job ends."
      },
      "securityPlugin": {
        "title": "Security system plugin",
        "type": "string",
