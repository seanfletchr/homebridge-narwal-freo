{
  "pluginAlias": "NarwalPlatform",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Shows the original Narwal Freo (model YJCC012) as a native robot vacuum in Apple Home (Matter). Needs Matter enabled for this plugin's child bridge. Unofficial: uses the same Narwal cloud as the app. Newer Narwal models are not supported.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Narwal Freo",
        "description": "Name of the plugin in the Homebridge log."
      },
      "email": {
        "title": "Narwal account email",
        "type": "string",
        "format": "email"
      },
      "password": {
        "title": "Narwal account password",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "region": {
        "title": "Narwal cloud region",
        "type": "string",
        "default": "us",
        "oneOf": [
          {
            "title": "United States / Canada",
            "enum": [
              "us"
            ]
          }
        ]
      },
      "appVersion": {
        "title": "Narwal app version (advanced)",
        "description": "Only change this if sign-in starts failing because Narwal refuses the built-in app version. Leave empty otherwise.",
        "type": "string"
      },
      "appVersionCode": {
        "title": "Narwal app version code (advanced)",
        "description": "Goes with the app version above. Leave empty unless you changed it.",
        "type": "string"
      },
      "robots": {
        "title": "Robots",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "serialNumber": {
              "title": "Serial number",
              "type": "string",
              "description": "Which robot on the Narwal account (picked on the settings page)."
            },
            "enabled": {
              "title": "Show in the Home app",
              "type": "boolean",
              "default": true
            },
            "name": {
              "title": "Name in the Home app",
              "type": "string",
              "description": "Defaults to the robot's name in the Narwal app."
            },
            "maps": {
              "title": "Floors",
              "type": "array",
              "description": "Names and stair detection for the maps saved on the robot, one entry per map (set on the settings page). A map or room left out keeps the name from the Narwal app.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "title": "Map ID",
                    "type": "integer",
                    "description": "The map's number on the robot (1 is usually the main map)."
                  },
                  "name": {
                    "title": "Name in the Home app",
                    "type": "string",
                    "description": "Defaults to the map's name in the Narwal app."
                  },
                  "stairDetection": {
                    "title": "Stair detection",
                    "type": "boolean",
                    "default": true,
                    "description": "Turn off only on floors with no stairs going down. The plugin sets the robot to this before every clean on the floor."
                  },
                  "rooms": {
                    "title": "Rooms",
                    "type": "array",
                    "description": "Room names to show in the Home app instead of the ones from the Narwal app.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "title": "Room ID",
                          "type": "integer",
                          "description": "The room's number on this map."
                        },
                        "name": {
                          "title": "Name in the Home app",
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
